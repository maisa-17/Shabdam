# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log

# OS / OneDrive
Thumbs.db
desktop.ini

# editors
.vscode/
.idea/

# personal Claude Code settings (shared skills in .claude/skills stay tracked)
.claude/settings.local.json

# temporary preview pages used for screenshots
/public/__*.html

# design reference (large bundled prototype, not part of the site)
/Shabdham Website Prototype & Wireframe.html
